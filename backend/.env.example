# Copy to backend/.env. Only the selected vision provider needs a key.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Use models supporting image input. Override with an account-accessible model.
OPENAI_VISION_MODEL=gpt-4.1-mini
DEEPSEEK_VISION_MODEL=deepseek-flash
OPENAI_API_BASE=https://api.openai.com/v1
DEEPSEEK_API_BASE=https://api.deepseek.com

# Optional cloud speech, independent of GPT / DeepSeek vision selection.
# Browser speech is the default and does not need a separate speech API key.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx

# ElevenLabs: confirm the voices are available in your account's My Voices.
# Keep the API key only in backend/.env.
ELEVENLABS_API_KEY=
ELEVENLABS_GRANDMA_VOICE_ID=a9yHA5lfQW9CpWgY8LQ1
ELEVENLABS_SKEPTIC_VOICE_ID=nEmYxpBHm0yWlH0rOlp3
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

ALLOW_DEMO=true
MAX_CONCURRENT_REQUESTS=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
